# =============================================================================
# itc_ocserv-dashboard — environment configuration
# =============================================================================
# Auto-generated by install.sh. Edit manually after first run if needed.
# Do NOT commit your .env (only .env.sample).
# =============================================================================

# -----------------------------------------------------------------------------
# Required secrets — install.sh generates strong values; never reuse defaults.
# Both must be at least 16 characters; the API refuses to start otherwise.
# -----------------------------------------------------------------------------
SECRET_KEY=replace-me-with-32-random-bytes
JWT_SECRET=replace-me-with-32-random-bytes

# -----------------------------------------------------------------------------
# Server identity
# -----------------------------------------------------------------------------
HOST=oc.example.com

# Port ocserv listens on. OCSERV_TCP_PORT / OCSERV_UDP_PORT both default to
# this value, so a single-port setup only needs OCSERV_PORT.
OCSERV_PORT=443

# Split listeners — set these only when a TCP-only load balancer (HAProxy,
# nginx stream, AWS NLB) fronts the TCP port. HAProxy cannot forward generic
# UDP, so DTLS traffic has to reach this host directly:
#
#   client --TCP 443--> HAProxy --TCP 8443 (+PROXY hdr)--> ocserv
#   client --UDP 443--------------- direct NAT ---------->  ocserv
#
# Example for that topology:
#   OCSERV_TCP_PORT=8443
#   OCSERV_UDP_PORT=443
#OCSERV_TCP_PORT=443
#OCSERV_UDP_PORT=443

# Disable DTLS entirely (everything over TCP). Simpler behind a TCP-only
# load balancer, but noticeably slower on lossy or mobile links.
OC_NO_UDP=false

# -----------------------------------------------------------------------------
# VPN network configuration
# -----------------------------------------------------------------------------
OC_NET=172.16.24.0/24
OCSERV_DNS=8.8.8.8

# Routes pushed to clients. Comma-separated. CIDR or "ip/mask" both work.
# Empty = no extra routes; 0.0.0.0/0 = full tunnel.
OC_ROUTES=192.168.0.0/24

# Split-DNS: domains whose lookups are forwarded through the VPN's DNS.
# Comma-separated, one entry per domain. Empty = disabled.
#   OC_SPLIT_DNS=example.com,corp.local
OC_SPLIT_DNS=

# tunnel-all-dns mode. Leave empty for auto:
#   - empty + OC_SPLIT_DNS empty   => true  (route every DNS via VPN)
#   - empty + OC_SPLIT_DNS set     => false (only split-dns domains via VPN)
#   - "true"  / "false"            => explicit override
OC_TUNNEL_ALL_DNS=

# Enable HAProxy PROXY protocol on the ocserv listener. Useful when the
# server sits behind a TCP load balancer that forwards client IPs via the
# PROXY header (HAProxy, nginx stream module, AWS NLB, etc.).
OC_LISTEN_PROXY_PROTO=false

# Camouflage prefix. Clients connect to https://<HOST>/?<OC_CAMOUFLAGE>;
# others get a generic HTTP 401. Empty = camouflage off.
OC_CAMOUFLAGE=replace-me-with-a-secret-word

# -----------------------------------------------------------------------------
# TLS certificate
# -----------------------------------------------------------------------------
# Two ways to provide certificates:
#
#   CERTBOT_ENABLED=true  — container runs certbot (port 80 must be public).
#   CERTBOT_ENABLED=false — mount certs from host at /opt/certs:ro:
#       /opt/certs/live/<SSL_CN>/fullchain.pem
#       /opt/certs/live/<SSL_CN>/privkey.pem
CERTBOT_ENABLED=false
CERTBOT_EMAIL=admin@example.com

# Port certbot binds for the HTTP-01 challenge. Use 80 when nothing else owns
# it; set to e.g. 8080 when a reverse proxy on this host already listens on
# :80 and forwards /.well-known/acme-challenge/ to this port.
CERTBOT_HTTP_PORT=80
SSL_CN=oc.example.com
SSL_ORG=itc
SSL_EXPIRE=3650

# -----------------------------------------------------------------------------
# RADIUS authentication (optional)
# -----------------------------------------------------------------------------
# When RADIUS_ENABLED=true:
#   - the auth = line in ocserv.conf is set to radius[...]
#   - config-per-group / config-per-user lines are commented out
#     (otherwise ocserv aborts on startup with missing per-user files)
#   - the local user-management UI keeps working but is NOT consulted for
#     authentication
RADIUS_ENABLED=false
RADIUS_SERVER=radius.example.com
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
RADIUS_SECRET=replace-with-radius-shared-secret
RADIUS_NAS_ID=ocserv-vpn

# -----------------------------------------------------------------------------
# PostgreSQL (embedded — runs inside the same container)
# -----------------------------------------------------------------------------
# Listens on 127.0.0.1 only. Persisted in the /app/db volume.
# With network_mode=host this binds to the HOST's loopback. If your host
# already runs Postgres on 5432, change POSTGRES_PORT here.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ocserv_db
POSTGRES_USER=ocserv
POSTGRES_PASSWORD=replace-me-with-strong-postgres-password
POSTGRES_SSLMODE=disable

# -----------------------------------------------------------------------------
# Internal service ports
# -----------------------------------------------------------------------------
# Bumped to the 1xxxx range so they don't clash with anything else on the
# host (the container runs with network_mode=host). Override if you have a
# specific reason — but do NOT use ports below 10000 unless you know they're
# free on your host.
API_PORT=18080
LOG_STREAM_PORT=18081
WEBHOOK_PORT=18888

# nginx listeners.
NGINX_HTTP_PORT=3080
NGINX_HTTPS_PORT=3443

# -----------------------------------------------------------------------------
# Networking
# -----------------------------------------------------------------------------
# With host networking, the container manipulates the HOST's iptables to set
# up MASQUERADE for OC_NET. Set SKIP_NAT=true to skip that and manage NAT
# yourself (e.g. via a firewall management tool).
SKIP_NAT=false

# -----------------------------------------------------------------------------
# Frontend / API
# -----------------------------------------------------------------------------
LANGUAGES=en:English,ru:Русский
ALLOW_ORIGINS=https://oc.example.com:3443,http://oc.example.com:3080
TZ=Asia/Vladivostok
